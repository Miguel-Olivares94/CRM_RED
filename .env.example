# Copia este archivo como .env para desarrollo local
# En Railway, configura estas variables en el panel de Variables de Entorno

# === OBLIGATORIAS ===
SECRET_KEY=cambia-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False

# Railway inyecta esto automáticamente al agregar el plugin PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Railway inyecta esto automáticamente al agregar el plugin Redis
REDIS_URL=redis://localhost:6379/0

# Clave de Anthropic para el Asistente IA
ANTHROPIC_API_KEY=sk-ant-...

# === OPCIONALES ===
# Hosts permitidos (Railway agrega .railway.app automáticamente)
ALLOWED_HOSTS=localhost,127.0.0.1

# Zona horaria
# TIME_ZONE=America/Santiago
